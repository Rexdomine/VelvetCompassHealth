PORT=8080
DB_PATH=./data/app.db
# Comma-separated origins, e.g. https://example.com,https://www.example.com
CORS_ORIGIN=velvetcompasshealth.com
ADMIN_EMAIL=office@velvetcompasshealth.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Velvet Compass Health
PUBLIC_SITE_URL=https://velvetcompasshealth.com
# Google Maps (frontend; safe to expose in browser, but restrict by domain in Google Cloud)
VITE_GOOGLE_MAPS_EMBED_API_KEY=
VITE_GOOGLE_MAPS_QUERY=23 Harley Street, London W1G 9QN
# Optional: set to true only when your Embed API key is fully configured (billing, API enabled, referrer restrictions).
VITE_GOOGLE_MAPS_USE_EMBED_API=false
